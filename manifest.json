{
  "manifest_version": 3,
  "name": "Filters+ for WebNovel",
  "version": "0.2.0",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "description": "Unofficial extra filters for webnovel.com categories: chapters, score, tags, words and date. Not affiliated with WebNovel.",
  "content_scripts": [
    {
      "matches": ["https://www.webnovel.com/stories/*", "https://www.webnovel.com/*/stories/*"],
      "js": ["filter.js", "i18n.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
