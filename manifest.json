{
  "manifest_version": 3,
  "name": "WebNovel Filters+",
  "version": "0.1.0",
  "permissions": ["storage"],
  "description": "Extra filters for webnovel.com category pages: chapters, score, tags, words and date.",
  "content_scripts": [
    {
      "matches": ["https://www.webnovel.com/stories/*", "https://www.webnovel.com/*/stories/*"],
      "js": ["filter.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
